NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins. Use * only in development.
CORS_ORIGINS=http://localhost:5173

# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx/ALB).
TRUST_PROXY=0

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Set to false to hide /docs in production.
DOCS_ENABLED=true

# docker compose host port override
# API_PORT=3000
