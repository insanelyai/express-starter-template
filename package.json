{
  "name": "express-starter-template",
  "version": "1.0.0",
  "description": "Production-ready Express 5 + TypeScript starter template",
  "main": "dist/server.js",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insanelyai/express-starter-template.git"
  },
  "keywords": [
    "express",
    "typescript",
    "starter",
    "template"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/insanelyai/express-starter-template/issues"
  },
  "homepage": "https://github.com/insanelyai/express-starter-template#readme",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "oxlint": "^1.85.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
